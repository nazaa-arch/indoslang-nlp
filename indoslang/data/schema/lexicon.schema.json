{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndoSlang Lexicon Schema",
  "description": "Validation schema for IndoSlang dictionary files",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["senses", "ambiguous", "source", "license"],
    "properties": {
      "senses": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["normalized", "category", "confidence"],
          "properties": {
            "normalized": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "enum": ["slang", "abbreviation", "indoglish", "regional", "unit", "profanity", "particle", "general"]
            },
            "confidence": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "context_hint": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "ambiguous": {
        "type": "boolean"
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "notes": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
